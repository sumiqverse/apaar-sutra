      "options": { "legend": { "displayMode": "list" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(apaar_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 Latency"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(apaar_http_request_duration_seconds_bucket[5m])) by (le))",
