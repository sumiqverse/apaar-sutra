# ==============================================================================
# APAAR-Sutra Platform Environment Configuration
# Smart India Hackathon Problem 26263 (AICTE)
# ==============================================================================

# --- Application Runtime Settings ---
# Runtime environment: 'development', 'staging', or 'production'
ENVIRONMENT=development
# Name of the service deployed
APP_NAME=APAAR-Sutra
# Debug flag (MUST be false in production)
DEBUG=false
# Host interface to bind server
HOST=0.0.0.0
# Port to expose backend application
PORT=8000
# Base routing prefix for versioned endpoints
API_V1_PREFIX=/api/v1
# Secret key used for cryptographic hashing and JWT session tokens (min 32 chars)
SECRET_KEY=change-me-super-secret-key-32-chars-minimum-in-production

# --- Field-Level Cryptography (AES-256-GCM & Blind Indexing) ---
# Active key ID used for all new encryption operations
CURRENT_KEY_ID=v1
# JSON mapping of versioned 256-bit (64 hex characters / 32-bytes) encryption keys
FIELD_ENCRYPTION_KEYS={"v1":"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef","v2":"fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210"}
# HMAC-SHA256 blind indexing key for exact-match equality search on encrypted fields
BLIND_INDEX_KEY=abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789

# --- Demo Account Credentials ---
DEMO_SUPERADMIN_PASSWORD=SuperAdmin@AICTE2026!
DEMO_INSTITUTION_PASSWORD=InstAdmin@AICTE2026!
DEMO_STUDENT_PASSWORD=Student@AICTE2026!
DEMO_VERIFIER_PASSWORD=Verifier@TCS2026!

# --- CORS & Security Settings ---
# Comma-separated list of allowed origins for cross-origin resource sharing
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
# Comma-separated list of allowed HTTP host headers
ALLOWED_HOSTS=localhost,127.0.0.1,backend,nginx

# --- PostgreSQL 16 Database Configuration ---
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=apaar_user
POSTGRES_PASSWORD=apaar_secure_password_2026
POSTGRES_DB=apaar_sutra_db
# Synchronous connection string for Alembic & standard queries
DATABASE_URL=postgresql://apaar_user:apaar_secure_password_2026@postgres:5432/apaar_sutra_db
# Asynchronous connection string for async FastAPI DB sessions
DATABASE_ASYNC_URL=postgresql+asyncpg://apaar_user:apaar_secure_password_2026@postgres:5432/apaar_sutra_db

# --- Redis 7 Configuration ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# --- Celery & Celery Beat Task Queue ---
# Message broker URL for Celery
CELERY_BROKER_URL=redis://redis:6379/1
# Result backend store for Celery completed task states
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- National APAAR Gateway & Integrations ---
# URL for the mock/live National APAAR verification registry gateway
APAAR_GATEWAY_URL=http://backend:8000/api/v1/mock-apaar
# Authorized client API key for accessing government gateway services
APAAR_API_KEY=mock-government-apaar-api-key-test-2026

# --- Logging & Observability ---
# Minimum logging level: 'DEBUG', 'INFO', 'WARNING', 'ERROR', 'CRITICAL'
LOG_LEVEL=INFO
# Log output format: 'json' (production standard) or 'console' (colored text)
LOG_FORMAT=json

# --- Frontend Environment Variables (Vite) ---
# Base API URL consumed by frontend Axios/Fetch client
VITE_API_URL=/api/v1
# Default platform language: 'en' (English) or 'hi' (Hindi)
VITE_DEFAULT_LOCALE=en
