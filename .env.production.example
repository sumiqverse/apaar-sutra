# ==============================================================================
# APAAR-Sutra Production Environment Variables (.env.production)
# Copy to .env.production and populate secure 256-bit secrets.
# NEVER commit .env.production to source control!
# ==============================================================================

# Core Application
APP_NAME=APAAR-Sutra
APP_ENV=production
DEBUG=false
HOST=0.0.0.0
PORT=8000
SECRET_KEY=CHANGE_THIS_TO_A_CRYPTOGRAPHICALLY_SECURE_64_CHAR_HEX_KEY
PUBLIC_BASE_URL=https://apaar.yourdomain.gov.in

# Database Settings (PostgreSQL 16)
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=apaar_prod_user
POSTGRES_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD_MIN_32_CHARS
POSTGRES_DB=apaar_sutra_prod_db
DATABASE_URL=postgresql://apaar_prod_user:${POSTGRES_PASSWORD}@postgres:5432/apaar_sutra_prod_db
DATABASE_ASYNC_URL=postgresql+asyncpg://apaar_prod_user:${POSTGRES_PASSWORD}@postgres:5432/apaar_sutra_prod_db

# Cache & Message Broker (Redis 7)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_TO_SECURE_REDIS_PASSWORD
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/1
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@redis:6379/2

# Cryptography & Security Keys
# 32-byte Base64-encoded AES key for database column-level encryption
ENCRYPTION_KEY=CHANGE_THIS_TO_A_32_BYTE_BASE64_KEY_GENERATE_VIA_OPENSSL
# Secret salt for blind-index hashing (HMAC-SHA256)
BLIND_INDEX_SALT=CHANGE_THIS_TO_RANDOM_SALT_64_CHARS
# JWT Signing Secret (256-bit)
JWT_SECRET_KEY=CHANGE_THIS_TO_SECURE_JWT_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Ed25519 Signing Keys for Verifiable Credentials
KEY_PROVIDER_TYPE=file
SIGNING_KEY_ID=sutra-ed25519-2026-v1
SIGNING_KEY_PATH=/etc/apaar/keys/ed25519_private.pem
PUBLIC_KEY_PATH=/etc/apaar/keys/ed25519_public.pem

# Disaster Recovery
BACKUP_ENCRYPTION_KEY=CHANGE_THIS_TO_LONG_DISASTER_RECOVERY_PASSPHRASE

# Observability
GRAFANA_ADMIN_PASSWORD=CHANGE_THIS_TO_GRAFANA_ADMIN_PASSWORD
